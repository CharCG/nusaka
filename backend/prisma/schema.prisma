generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ExerciseType {
  MATCHING
  WORD_ORDER
  MULTIPLE_CHOICE
  TRANSLATION
  FILL_BLANK
}

enum LessonAttemptStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  ABANDONED
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  nickname     String?
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)

  passwordResetTokens PasswordResetToken[]

  stats        UserStats?
  inventory    UserInventory?
  achievements UserAchievement[]

  lessonAttempts     LessonAttempt[]
  lessonProgresses   LessonProgress[]
  idempotencyRecords IdempotencyRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String @id @default(uuid())
  userId    String
  tokenHash String @unique

  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserStats {
  userId        String @id
  xp            Int    @default(0)
  lives         Int    @default(25)
  gems          Int    @default(25)
  currentStreak Int    @default(0)
  longestStreak Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserInventory {
  userId       String @id
  streakFreeze Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  users UserAchievement[]
}

model UserAchievement {
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@id([userId, achievementId])
}

model Language {
  id   String @id @default(uuid())
  code String @unique
  name String

  units Unit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Unit {
  id         String @id @default(uuid())
  languageId String
  title      String
  order      Int

  chapters Chapter[]

  language Language @relation(fields: [languageId], references: [id])

  @@unique([languageId, order])
}

model Chapter {
  id     String @id @default(uuid())
  unitId String
  title  String
  order  Int

  lessons Lesson[]

  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([unitId, order])
}

model Lesson {
  id        String @id @default(uuid())
  chapterId String
  title     String
  order     Int

  exercises Exercise[]

  attempts   LessonAttempt[]
  progresses LessonProgress[]

  chapter Chapter @relation(fields: [chapterId], references: [id])

  @@unique([chapterId, order])
}

model Exercise {
  id       String       @id @default(uuid())
  lessonId String
  type     ExerciseType
  order    Int
  question Json
  answer   Json

  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([lessonId, order])
}

model LessonAttempt {
  id                   String              @id @default(uuid())
  userId               String
  lessonId             String
  status               LessonAttemptStatus @default(IN_PROGRESS)
  currentExerciseOrder Int                 @default(1)
  mistakes             Int                 @default(0)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@index([userId, status])
}

model LessonProgress {
  userId    String
  lessonId  String
  isPerfect Boolean @default(false)

  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@id([userId, lessonId])
}

model IdempotencyRecord {
  id          String @id @default(uuid())
  userId      String
  key         String
  requestHash String
  response    Json

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}
